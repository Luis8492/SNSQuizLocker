{
  "manifest_version": 3,
  "name": "SNSQuizLocker",
  "version": "1.0.2",
  "description": "SNSを開くとクイズ（古典文学の書き取り・百人一首・聴音・詰将棋）を出題し、全問正解するまでブロックする見すぎ防止ツール。ロック対象のサイトは設定画面から選べます。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "SNSQuizLocker の設定",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "core/registry.js",
        "core/ui.js",
        "config.js",
        "core/sites.js",
        "quizzes/koten/passages.js",
        "quizzes/koten/koten.js",
        "quizzes/hyakunin/poems.js",
        "quizzes/hyakunin/hyakunin.js",
        "quizzes/juon/juon.js",
        "quizzes/senritsu/senritsu.js",
        "quizzes/tsume/shogi.js",
        "quizzes/tsume/problems.js",
        "quizzes/tsume/tsume.js",
        "core/host.js"
      ],
      "css": [
        "core/overlay.css",
        "quizzes/koten/koten.css",
        "quizzes/hyakunin/hyakunin.css",
        "quizzes/juon/juon.css",
        "quizzes/senritsu/senritsu.css",
        "quizzes/tsume/tsume.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "continue.html",
        "core/registry.js",
        "core/ui.js",
        "config.js",
        "core/sites.js",
        "quizzes/koten/passages.js",
        "quizzes/koten/koten.js",
        "quizzes/hyakunin/poems.js",
        "quizzes/hyakunin/hyakunin.js",
        "quizzes/juon/juon.js",
        "quizzes/senritsu/senritsu.js",
        "quizzes/tsume/shogi.js",
        "quizzes/tsume/problems.js",
        "quizzes/tsume/tsume.js",
        "core/overlay.css",
        "quizzes/koten/koten.css",
        "quizzes/hyakunin/hyakunin.css",
        "quizzes/juon/juon.css",
        "quizzes/senritsu/senritsu.css",
        "quizzes/tsume/tsume.css"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.reddit.com/*"
      ]
    }
  ]
}
